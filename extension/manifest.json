{
  "manifest_version": 3,
  "name": "LeetGate",
  "description": "Gate social media until you solve NeetCode-150 Easy/Medium problems.",
  "version": "0.1.0",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/leetcode-tracker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
